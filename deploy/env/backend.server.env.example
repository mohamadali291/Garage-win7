# VPS (central sync server)
# Copy to backend/.env on the VPS (or export these in systemd)

PORT=4000
CORS_ORIGIN=*

# Server role (default is server; set explicitly for clarity)
SYNC_ROLE=server

# Set to true to disable login: /api/* accepts requests without Bearer token (single-user / kiosk mode).
# If you get 401 Unauthorized on garage.yourdomain.com, set this and restart the backend.
# NO_LOGIN=true

# Persistent SQLite location on VPS (ensure the directory exists and is writable)
DB_PATH=/var/lib/garage/garage.sqlite

