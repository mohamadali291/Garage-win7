# Laptop (offline-first client)
# Copy to backend/.env on EACH laptop (unique SYNC_DEVICE_TOKEN per laptop)

PORT=4000
CORS_ORIGIN=*

SYNC_ROLE=client

# Local laptop DB (pick a path that persists on that laptop)
DB_PATH=./data/garage.sqlite

# VPS API base URL (no trailing /api needed)
SYNC_REMOTE_URL=https://sync.yourdomain.com

# Unique per laptop (create on VPS via POST /api/admin/devices)
SYNC_DEVICE_TOKEN=put-device-token-here

# Optional: auto-sync interval in ms (0 disables)
SYNC_INTERVAL_MS=0

