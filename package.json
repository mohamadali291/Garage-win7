{
  "name": "garage-management-system",
  "version": "1.0.0",
  "description": "Garage Management System - Local Desktop App with Cloud Sync",
  "main": "electron-main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "frontend:dev": "cd frontend && npm run dev",
    "electron:dev": "concurrently -k \"npm run frontend:dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run frontend:build && npm run backend:install && npm run backend:rebuild-electron && electron-builder",
    "backend:rebuild-electron": "cd backend && npx electron-rebuild",
    "frontend:build": "cd frontend && npm run build",
    "backend:install": "cd backend && npm install",
    "frontend:install": "cd frontend && npm install",
    "postinstall": "npm run backend:install && npm run frontend:install && electron-builder install-app-deps",
    "dist": "npm run electron:build"
  },
  "author": "Hamdan EV Tronics",
  "license": "ISC",
  "build": {
    "appId": "com.hamdan.garage",
    "productName": "Hamdan Garage Manager",
    "files": [
      "electron-main.js",
      "backend/**/*",
      "!backend/node_modules/**",
      "!backend/data/**",
      "frontend/dist/**/*",
      "build/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hamdan Garage Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "better-sqlite3": "12.6.0",
    "dotenv": "^17.2.3"
  }
}
